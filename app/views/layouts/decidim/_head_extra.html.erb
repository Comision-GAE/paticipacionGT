<% if Rails.application.secrets.dig(:analytics, :google_analytics_tracking_id).present? %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= Rails.application.secrets.dig(:analytics, :google_analytics_tracking_id) %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', '<%= Rails.application.secrets.dig(:analytics, :google_analytics_tracking_id) %>');
  </script>
<% end %>