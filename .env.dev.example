# Volumes
STORAGE_PATH=/home/user/volumes/storage
LOGS_PATH=/home/user/volumes/logs
PUBLIC_PATH=/home/user/volumes/public
RAILS_ENV=development
RAILS_PORT=3000

SECRET_KEY_BASE=secret_key_base

# Database
DATABASE_HOST=pg
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=db_name
POSTGRES_PATH=/home/user/volumes/database
MAPS_API_KEY=maps_api_key
# If you want to recreate the database on each container startup
DATABASE_RECREATE=false
